# Cloudflare Worker + R2 文件分享系统
name = "cloudshare"
main = "src/index.ts"
compatibility_date = "2025-05-31"

# R2 存储桶 - 存放所有上传文件
# 创建命令: npx wrangler r2 bucket create <bucket_name>
[[r2_buckets]]
binding = "FILES_BUCKET"
bucket_name = "<bucket_name>"

# KV 命名空间 - 存放分享令牌元数据
# 创建命令: npx wrangler kv namespace create cloudshare_shares
# 创建后将返回的 id 填入下方
[[kv_namespaces]]
binding = "cloudshare_shares"
id = "KV_ID"

# 允许的 CORS Origin (可选, 留空 = 同源)
# 多个 origin 不支持, 只能配置一个, 或者留空禁用跨域
# 部署命令: npx wrangler secret put ALLOWED_ORIGIN
# [vars]
# ALLOWED_ORIGIN = "https://share.example.com"
